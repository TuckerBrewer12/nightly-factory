# GitHub OAuth app (github.com/settings/developers → New OAuth App)
# Callback URL: https://<your-vercel-domain>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Who may sign in (GitHub logins, comma separated)
ALLOWED_USERS=TuckerBrewer12,GuoAnWang25

# 32+ random characters: `openssl rand -base64 32`
SESSION_SECRET=

# Optional. A fine-grained token with read access to the repo, used for page reads
# so they're cached across viewers. Without it, reads use the signed-in viewer's token.
GITHUB_TOKEN=

# Optional overrides (defaults in factory.config.ts)
# FACTORY_REPO=TuckerBrewer12/BirdieEyeView
